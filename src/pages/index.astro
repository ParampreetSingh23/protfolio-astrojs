---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <!-- HERO SECTION (Pure Black Canvas, white text, bold compressed typography) -->
  <section id="home" class="min-h-[80vh] md:min-h-screen bg-canvas text-white relative overflow-hidden flex flex-col justify-start pt-10 md:pt-20 pb-20 border-b border-hairline">
    
    <!-- Left side rotated indicator -->
    <div class="absolute left-6 bottom-16 hidden lg:flex items-center gap-3 origin-left -rotate-90 translate-y-12">
      <span class="w-1.5 h-1.5 rounded-full bg-accent-blue animate-ping"></span>
      <span class="w-1.5 h-1.5 rounded-full bg-accent-blue absolute"></span>
      <span class="font-mono text-xs tracking-widest text-ink-muted uppercase">01. Start</span>
      <span class="w-12 h-px bg-hairline"></span>
    </div>

    <div class="max-w-7xl mx-auto px-6 w-full relative z-10 grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      <!-- Main Intro Copy -->
      <div class="lg:col-span-8 flex flex-col justify-center">
        <p class="font-mono text-[13px] tracking-wider uppercase text-accent-blue mb-6 flex items-center gap-2">
          <span class="w-1.5 h-1.5 rounded-full bg-accent-blue"></span> Parampreet Singh &mdash; Portfolio
        </p>
        
        <!-- Large Heading with inline-graphic svg capsules and aggressive letter-spacing (-4.25px / -5.5px) -->
        <h1 class="text-4xl md:text-7xl lg:text-[85px] font-medium tracking-[-0.05em] leading-[0.95] text-white mb-8 font-display font-feature-display">
          Parampreet 
          <!-- Inline Graphic 1 (Circuit board pattern) -->
          <span class="inline-flex items-center align-middle mx-1 md:mx-2 px-3 py-1 bg-surface-1 rounded-[20px] border border-hairline h-[38px] md:h-[58px] lg:h-[68px] w-[70px] md:w-[110px] lg:w-[130px] overflow-hidden select-none">
            <svg class="w-full h-full text-accent-blue opacity-85" viewBox="0 0 100 40" fill="none" stroke="currentColor">
              <path d="M10 20h20l10-10h20l10 10h20" stroke-width="1.5" stroke-dasharray="2 2" />
              <circle cx="10" cy="20" r="3" fill="currentColor" />
              <circle cx="90" cy="20" r="3" fill="currentColor" />
              <circle cx="40" cy="10" r="2" fill="currentColor" />
              <circle cx="60" cy="10" r="2" fill="currentColor" />
            </svg>
          </span>
          Singh
          <br />
          <span class="text-ink-muted">Building the Future of Web Apps.</span>
        </h1>

        <p class="text-base md:text-lg text-ink-muted max-w-xl leading-relaxed mb-10 font-sans font-light tracking-[-0.15px]">
          I'm a Computer Science student who crafts robust full-stack platforms, configures scalable cloud systems on AWS, and designs clean automations.
        </p>

        <!-- CTA Buttons (Framer pill designs) -->
        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-4">
          <a 
            href="#projects" 
            class="px-[20px] py-[12px] rounded-[100px] bg-white text-black font-sans text-[14px] font-medium tracking-[-0.14px] leading-none hover:bg-slate-200 transition-colors text-center flex items-center justify-center gap-2 group"
          >
            View Projects 
            <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>
          <a 
            href="/resume.pdf" 
            download="Parampreet_Singh_Resume.pdf"
            class="px-[20px] py-[12px] rounded-[100px] bg-surface-1 hover:bg-surface-2 border border-hairline text-white font-sans text-[14px] font-medium tracking-[-0.14px] leading-none transition-colors text-center flex items-center justify-center gap-2"
          >
            Download Resume
          </a>
        </div>
      </div>
      
      <!-- Right Side Minimal Stats (Swiss Layout) -->
      <div class="lg:col-span-4 grid grid-cols-2 gap-4 lg:pl-8 mt-8 lg:mt-0 font-mono border-t lg:border-t-0 lg:border-l border-hairline pt-8 lg:pt-0 lg:h-80 flex flex-col justify-center">
        <div class="border-b border-hairline pb-4">
          <span class="text-xs text-ink-muted block uppercase mb-1">Focus</span>
          <span class="text-sm font-bold text-white block">Full Stack DevOps</span>
        </div>
        <div class="border-b border-hairline pb-4">
          <span class="text-xs text-ink-muted block uppercase mb-1">AWS Status</span>
          <span class="text-sm font-bold text-white block">Practitioner (In Prep)</span>
        </div>
        <div class="border-b border-hairline pb-4">
          <span class="text-xs text-ink-muted block uppercase mb-1">Education</span>
          <span class="text-sm font-bold text-white block">B.Tech CSE (2027)</span>
        </div>
        <div class="border-b border-hairline pb-4">
          <span class="text-xs text-ink-muted block uppercase mb-1">Automation</span>
          <span class="text-sm font-bold text-white block">n8n / Bash / CI-CD</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ABOUT ME SECTION (Pure Black Canvas, Asymmetric poster rhythm) -->
  <section id="about" class="min-h-screen bg-canvas text-white relative overflow-hidden flex flex-col justify-center py-32 border-b border-hairline">
    
    <!-- Left side rotated indicator -->
    <div class="absolute left-6 bottom-16 hidden lg:flex items-center gap-3 origin-left -rotate-90 translate-y-12">
      <span class="w-1.5 h-1.5 rounded-full bg-accent-blue"></span>
      <span class="font-mono text-xs tracking-widest text-ink-muted uppercase">02. Profile</span>
      <span class="w-12 h-px bg-hairline"></span>
    </div>

    <div class="max-w-7xl mx-auto px-6 w-full relative z-10 grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
      <!-- Section Header -->
      <div class="lg:col-span-5 lg:sticky lg:top-28">
        <span class="font-mono text-xs text-accent-blue uppercase tracking-widest block mb-4">/profile-history</span>
        <h2 class="text-3xl md:text-5xl font-medium tracking-[-0.05em] leading-[1.00] text-white mb-8 font-display">
          Passionate about <br />
          <span class="text-ink-muted">clean code</span> & automated architecture.
        </h2>
        <div class="space-y-6 text-ink-muted text-[15px] leading-[1.30] tracking-[-0.15px] font-light">
          <p>
            I am a Computer Science student at <strong class="text-white font-medium">Chitkara University</strong>, driven by a deep curiosity about how systems run under the hood. My coding path started with Java and evolved into constructing complex full-stack web applications.
          </p>
          <p>
            Currently, I'm deep diving into <strong class="text-white font-medium">Cloud & DevOps</strong>. I build high-availability node environments, containerize services using Docker, and automate complex pipelines using tools like n8n and Bash scripting.
          </p>
          <p>
            When I'm not writing code, I'm optimizing local dev environments, researching deployment scripts, or coordinating team projects.
          </p>
        </div>
      </div>

      <!-- Asymmetric showcase cards grid containing Framer's signature gradient cards (Image 4 style) -->
      <div class="lg:col-span-7 grid grid-cols-1 md:grid-cols-2 gap-6 lg:pl-6">
        
        <!-- Highlight Card 1: Vibrant Gradient Atmosphere Showcase Card (Violet) -->
        <div class="p-8 rounded-[30px] gradient-violet-bg border border-hairline flex flex-col justify-between h-80 text-white relative overflow-hidden shadow-lg md:col-span-2">
          <div>
            <span class="font-mono text-xs text-white/70 block mb-2">01 / STACK</span>
            <h3 class="text-[32px] font-medium tracking-[-1.0px] leading-[1.13] text-white font-display mb-3">
              Full Stack Engineering
            </h3>
            <p class="text-white/80 text-[14px] leading-[1.30] tracking-[-0.14px] font-light">
              Designing responsive React frontends, robust Node/Express/Spring Boot API backends, and configuring relational/document-store persistent databases (PostgreSQL, MongoDB, MySQL).
            </p>
          </div>
          <div class="flex items-center gap-2 font-mono text-xs text-white/90">
            <span>React &bull; Next.js &bull; Node &bull; Spring Boot</span>
          </div>
        </div>

        <!-- Highlight Card 2: Vibrant Gradient Atmosphere Showcase Card (Orange) -->
        <div class="p-8 rounded-[30px] gradient-orange-bg border border-hairline flex flex-col justify-between h-80 text-white relative overflow-hidden shadow-lg">
          <div>
            <span class="font-mono text-xs text-white/70 block mb-2">02 / OPS</span>
            <h3 class="text-[32px] font-medium tracking-[-1.0px] leading-[1.13] text-white font-display mb-3">
              Cloud & DevOps
            </h3>
            <p class="text-white/80 text-[14px] leading-[1.30] tracking-[-0.14px] font-light">
              Configuring AWS virtual instances, containerizing backend modules in Docker, setting up pipelines, and building visual workflows with n8n.
            </p>
          </div>
          <div class="flex items-center gap-2 font-mono text-xs text-white/90">
            <span>AWS &bull; Docker &bull; n8n &bull; Linux</span>
          </div>
        </div>

        <!-- Highlight Card 3: Vibrant Gradient Atmosphere Showcase Card (Magenta) -->
        <div class="p-8 rounded-[30px] gradient-magenta-bg border border-hairline flex flex-col justify-between h-80 text-white relative overflow-hidden shadow-lg">
          <div>
            <span class="font-mono text-xs text-white/70 block mb-2">03 / DSA</span>
            <h3 class="text-[32px] font-medium tracking-[-1.0px] leading-[1.13] text-white font-display mb-3">
              Problem Solving
            </h3>
            <p class="text-white/80 text-[14px] leading-[1.30] tracking-[-0.14px] font-light">
              Optimizing algorithms in Core Java and C++, relational query structuring, data structure design, and memory profiling.
            </p>
          </div>
          <div class="flex items-center gap-2 font-mono text-xs text-white/90">
            <span>Java &bull; C++ &bull; SQL &bull; Structures</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- SKILLS SECTION (Pure Black Canvas, Interactive dark Venn diagram) -->
  <section id="skills" class="min-h-screen bg-canvas text-white relative overflow-hidden flex flex-col justify-center py-32 border-b border-hairline">
    
    <!-- Left side rotated indicator -->
    <div class="absolute left-6 bottom-16 hidden lg:flex items-center gap-3 origin-left -rotate-90 translate-y-12">
      <span class="w-1.5 h-1.5 rounded-full bg-accent-blue"></span>
      <span class="font-mono text-xs tracking-widest text-ink-muted uppercase">03. Matrix</span>
      <span class="w-12 h-px bg-hairline"></span>
    </div>

    <div class="max-w-7xl mx-auto px-6 w-full relative z-10 grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      <!-- Left Column: Venn Diagram (Swiss schematic on black background) -->
      <div class="lg:col-span-6 flex justify-center relative py-8">
        <div class="w-full max-w-[420px] aspect-square relative select-none">
          <svg class="w-full h-full" viewBox="0 0 400 400" fill="none">
            <!-- Glow at the center intersection -->
            <circle cx="200" cy="210" r="40" fill="rgba(0, 153, 255, 0.25)" class="animate-pulse" />

            <!-- Circle 1: Web Development (Top) -->
            <g id="venn-web" class="cursor-pointer group/circle" data-category="web">
              <circle cx="200" cy="150" r="100" class="fill-surface-1/40 stroke-hairline group-hover/circle:fill-surface-2 group-hover/circle:stroke-accent-blue transition-all duration-300" stroke-width="1.5" />
              <text x="200" y="90" text-anchor="middle" class="font-mono text-xs font-bold fill-white group-hover/circle:fill-accent-blue transition-colors">WEB DEV</text>
            </g>

            <!-- Circle 2: Cloud & DevOps (Bottom Left) -->
            <g id="venn-devops" class="cursor-pointer group/circle" data-category="devops">
              <circle cx="140" cy="245" r="100" class="fill-surface-1/40 stroke-hairline group-hover/circle:fill-surface-2 group-hover/circle:stroke-accent-blue transition-all duration-300" stroke-width="1.5" />
              <text x="90" y="295" text-anchor="middle" class="font-mono text-xs font-bold fill-white group-hover/circle:fill-accent-blue transition-colors">CLOUD & DEVOPS</text>
            </g>

            <!-- Circle 3: Programming & DB (Bottom Right) -->
            <g id="venn-prog" class="cursor-pointer group/circle" data-category="programming">
              <circle cx="260" cy="245" r="100" class="fill-surface-1/40 stroke-hairline group-hover/circle:fill-surface-2 group-hover/circle:stroke-accent-blue transition-all duration-300" stroke-width="1.5" />
              <text x="310" y="295" text-anchor="middle" class="font-mono text-xs font-bold fill-white group-hover/circle:fill-accent-blue transition-colors">PROG & DB</text>
            </g>

            <!-- Central Overlap Region (Accent Blue overlapping path) -->
            <path 
              id="venn-intersection"
              d="M 200,183 A 100,100 0 0,1 224,228 A 100,100 0 0,1 176,228 A 100,100 0 0,1 200,183 Z" 
              class="fill-accent-blue stroke-accent-blue/80 cursor-pointer hover:scale-105 origin-center transition-all duration-300"
              stroke-width="1"
              data-category="intersection"
            />
            <text x="200" y="215" text-anchor="middle" class="font-mono text-[9px] font-extrabold fill-black pointer-events-none">DEV</text>
            <text x="200" y="224" text-anchor="middle" class="font-mono text-[9px] font-extrabold fill-black pointer-events-none">OPS</text>
          </svg>
          
          <div class="absolute bottom-2 left-1/2 -translate-x-1/2 text-center">
            <span class="font-mono text-[10px] text-ink-muted block uppercase">← Hover circles to query skills →</span>
          </div>
        </div>
      </div>

      <!-- Right Column: Interactive Details Panel -->
      <div class="lg:col-span-6 flex flex-col justify-center lg:pl-12">
        <span class="font-mono text-xs text-ink-muted uppercase tracking-widest block mb-4">/skills-matrix</span>
        <h3 class="text-3xl md:text-4xl font-medium tracking-[-0.05em] leading-[1.00] text-white mb-6 font-display" id="skills-title">
          My Tech Synthesis
        </h3>
        <p class="text-ink-muted text-[15px] leading-[1.30] tracking-[-0.15px] mb-8 font-light font-sans" id="skills-desc">
          I build at the intersection of full-stack engineering, cloud architecture, and database performance. Hover over any circle in the diagram to inspect my specific skill domains.
        </p>

        <!-- Skill Pills Container -->
        <div id="skills-container" class="flex flex-wrap gap-2 transition-all duration-300">
          <!-- Default View: Shows All Skills -->
          <!-- Web Dev -->
          <span class="px-3 py-1.5 rounded-[6px] bg-surface-1 text-white border border-hairline font-mono text-[13px] tracking-tight">HTML/CSS</span>
          <span class="px-3 py-1.5 rounded-[6px] bg-surface-1 text-white border border-hairline font-mono text-[13px] tracking-tight">React.js</span>
          <span class="px-3 py-1.5 rounded-[6px] bg-surface-1 text-white border border-hairline font-mono text-[13px] tracking-tight">Next.js (Learning)</span>
          <span class="px-3 py-1.5 rounded-[6px] bg-surface-1 text-white border border-hairline font-mono text-[13px] tracking-tight">Node.js</span>
          <span class="px-3 py-1.5 rounded-[6px] bg-surface-1 text-white border border-hairline font-mono text-[13px] tracking-tight">Express.js</span>
          <span class="px-3 py-1.5 rounded-[6px] bg-surface-1 text-white border border-hairline font-mono text-[13px] tracking-tight">Spring Boot</span>
          <!-- Cloud & DevOps -->
          <span class="px-3 py-1.5 rounded-[6px] bg-surface-1 text-white border border-hairline font-mono text-[13px] tracking-tight">AWS (EC2, S3, RDS)</span>
          <span class="px-3 py-1.5 rounded-[6px] bg-surface-1 text-white border border-hairline font-mono text-[13px] tracking-tight">Docker</span>
          <span class="px-3 py-1.5 rounded-[6px] bg-surface-1 text-white border border-hairline font-mono text-[13px] tracking-tight">CI/CD Pipelines</span>
          <span class="px-3 py-1.5 rounded-[6px] bg-surface-1 text-white border border-hairline font-mono text-[13px] tracking-tight">n8n Automation</span>
          <span class="px-3 py-1.5 rounded-[6px] bg-surface-1 text-white border border-hairline font-mono text-[13px] tracking-tight">Linux / Bash</span>
          <!-- Prog & DB -->
          <span class="px-3 py-1.5 rounded-[6px] bg-surface-1 text-white border border-hairline font-mono text-[13px] tracking-tight">Java</span>
          <span class="px-3 py-1.5 rounded-[6px] bg-surface-1 text-white border border-hairline font-mono text-[13px] tracking-tight">Data Structures (DSA)</span>
          <span class="px-3 py-1.5 rounded-[6px] bg-surface-1 text-white border border-hairline font-mono text-[13px] tracking-tight">C++</span>
          <span class="px-3 py-1.5 rounded-[6px] bg-surface-1 text-white border border-hairline font-mono text-[13px] tracking-tight">SQL</span>
          <span class="px-3 py-1.5 rounded-[6px] bg-surface-1 text-white border border-hairline font-mono text-[13px] tracking-tight">MongoDB / MySQL</span>
          <!-- Tools -->
          <span class="px-3 py-1.5 rounded-[6px] bg-surface-1 text-white border border-hairline font-mono text-[13px] tracking-tight">Git & GitHub</span>
          <span class="px-3 py-1.5 rounded-[6px] bg-surface-1 text-white border border-hairline font-mono text-[13px] tracking-tight">Postman / APIs</span>
        </div>
      </div>
    </div>
  </section>

  <!-- PROJECTS SECTION (Pure Black Canvas, Column-list layout) -->
  <section id="projects" class="min-h-screen bg-canvas text-white relative overflow-hidden flex flex-col justify-center py-32 border-b border-hairline">
    
    <!-- Left side rotated indicator -->
    <div class="absolute left-6 bottom-16 hidden lg:flex items-center gap-3 origin-left -rotate-90 translate-y-12">
      <span class="w-1.5 h-1.5 rounded-full bg-accent-blue"></span>
      <span class="font-mono text-xs tracking-widest text-ink-muted uppercase">04. Works</span>
      <span class="w-12 h-px bg-hairline"></span>
    </div>

    <div class="max-w-7xl mx-auto px-6 w-full relative z-10 grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
      <!-- Left Column (Sticky info block) -->
      <div class="lg:col-span-5 lg:sticky lg:top-28">
        <span class="font-mono text-xs text-accent-blue uppercase tracking-widest block mb-4">/projects-showcase</span>
        <h2 class="text-3xl md:text-5xl font-medium tracking-[-0.05em] leading-[1.00] text-white mb-8 font-display">
          Next-gen codebases <br />
          demand <span class="text-ink-muted">focused logic.</span>
        </h2>
        <p class="text-ink-muted text-[15px] leading-[1.30] tracking-[-0.15px] mb-8 font-light font-sans">
          A selection of projects that showcase my ability to write clean modular code, build APIs, and manage deployment networks.
        </p>
        <a 
          href="https://github.com/ParampreetSingh23" 
          target="_blank" 
          rel="noreferrer"
          class="px-[15px] py-[10px] rounded-[100px] bg-surface-1 hover:bg-surface-2 border border-hairline text-white font-sans text-[14px] font-medium tracking-[-0.14px] leading-none transition-colors text-center inline-flex items-center gap-2"
        >
          View GitHub
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
            <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.477 2 12c0 4.42 2.865 8.166 6.839 9.489.5.092.682-.217.682-.482 0-.237-.008-.866-.013-1.7-2.782.603-3.369-1.34-3.369-1.34-.454-1.156-1.11-1.462-1.11-1.462-.908-.62.069-.608.069-.608 1.003.07 1.531 1.03 1.531 1.03.892 1.529 2.341 1.087 2.91.831.092-.646.35-1.086.636-1.336-2.22-.253-4.555-1.11-4.555-4.943 0-1.091.39-1.984 1.029-2.683-.103-.253-.446-1.27.098-2.647 0 0 .84-.269 2.75 1.025A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.294 2.747-1.025 2.747-1.025.546 1.377.203 2.394.1 2.647.64.699 1.028 1.592 1.028 2.683 0 3.842-2.339 4.687-4.566 4.935.359.309.678.919.678 1.852 0 1.336-.012 2.415-.012 2.743 0 .267.18.579.688.481C19.137 20.162 22 16.418 22 12c0-5.523-4.477-10-10-10z" />
          </svg>
        </a>
      </div>

      <!-- Right Column: Card stack with hairline dividers (Image 4 style) -->
      <div class="lg:col-span-7 flex flex-col divide-y divide-hairline">
        <!-- Project 1 -->
        <div class="py-10 first:pt-0 group hover:translate-x-2 transition-transform duration-300">
          <div class="flex justify-between items-start mb-4">
            <span class="font-mono text-xs text-accent-blue">01 / FULL STACK</span>
            <a href="https://github.com/ParampreetSingh23" target="_blank" rel="noreferrer" class="text-ink-muted hover:text-white transition-colors" aria-label="GitHub Repository">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
              </svg>
            </a>
          </div>
          
          <h3 class="text-2xl font-bold text-white mb-3 flex items-center justify-between font-display">
            Student Attendance Tracker
            <span class="text-accent-blue group-hover:translate-x-1.5 transition-transform">→</span>
          </h3>
          
          <p class="text-ink-muted text-[14px] leading-[1.30] tracking-[-0.14px] font-light mb-6 font-sans">
            A comprehensive web attendance management system featuring automated email alerts. Implemented full CRUD operations with MongoDB and designed a clean responsive UI using EJS templates for a seamless admin experience.
          </p>
          
          <div class="flex flex-wrap gap-2">
            <span class="px-2.5 py-1 rounded-[6px] bg-surface-1 border border-hairline font-mono text-[11px] text-ink-muted">Node.js</span>
            <span class="px-2.5 py-1 rounded-[6px] bg-surface-1 border border-hairline font-mono text-[11px] text-ink-muted">Express</span>
            <span class="px-2.5 py-1 rounded-[6px] bg-surface-1 border border-hairline font-mono text-[11px] text-ink-muted">MongoDB</span>
            <span class="px-2.5 py-1 rounded-[6px] bg-surface-1 border border-hairline font-mono text-[11px] text-ink-muted">EJS</span>
          </div>
        </div>

        <!-- Project 2 -->
        <div class="py-10 group hover:translate-x-2 transition-transform duration-300">
          <div class="flex justify-between items-start mb-4">
            <span class="font-mono text-xs text-accent-blue">02 / FULL STACK</span>
            <a href="https://github.com/ParampreetSingh23" target="_blank" rel="noreferrer" class="text-ink-muted hover:text-white transition-colors" aria-label="GitHub Repository">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
              </svg>
            </a>
          </div>
          
          <h3 class="text-2xl font-bold text-white mb-3 flex items-center justify-between font-display">
            Campus Barter Platform
            <span class="text-accent-blue group-hover:translate-x-1.5 transition-transform">→</span>
          </h3>
          
          <p class="text-ink-muted text-[14px] leading-[1.30] tracking-[-0.14px] font-light mb-6 font-sans">
            A secure campus-exclusive marketplace platform enabling university students to exchange products and services. Built with a Spring Boot backend, ReactJS frontend, REST API layers, and custom token session security.
          </p>
          
