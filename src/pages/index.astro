---
import Layout from '../layouts/Layout.astro';
import '../styles/os.css';
import { listDir } from '../scripts/terminal';
import { iconFor, ui } from '../scripts/icons';
import { person, projects, experience, education } from '../data/portfolio';
const desktop = listDir('~/Desktop');
---
<Layout bare>
  <div id="boot" class="boot" aria-hidden="true">
    <pre id="boot-log"></pre>
    <p class="boot-skip">press any key to skip</p>
  </div>

  <div id="os" class="os">
    <header class="topbar">
      <span class="topbar-left">Activities <b>parampreet@portfolio</b></span>
      <time id="clock" class="topbar-clock"></time>
      <span class="topbar-tray" aria-hidden="true"><Fragment set:html={ui.Wifi} /><Fragment set:html={ui.Volume2} /><Fragment set:html={ui.BatteryFull} /><Fragment set:html={ui.Power} /></span>
    </header>

    <main class="desktop" id="desktop">
      <h1 class="sr-only">{person.name} — {person.role} portfolio</h1>
      <div class="wallmark" aria-hidden="true">parampreet<span>@</span>portfolio<small>open a file · or run ./github.sh</small></div>
      <ul class="icons" aria-label="Desktop files">
        {desktop.map(name => (
          <li><button class="file-icon" data-path={`~/Desktop/${name}`}><span set:html={iconFor(name)} /><span class="file-name">{name}</span></button></li>
        ))}
      </ul>
      <div id="windows"></div>
    </main>

    <nav class="dock" id="dock" aria-label="Dock">
      <button data-app="terminal" title="Terminal" aria-label="Terminal"><Fragment set:html={ui.SquareTerminal} /></button>
      <button data-app="browser" title="Browser" aria-label="Browser"><Fragment set:html={ui.Globe} /></button>
      <button data-app="files" title="Files" aria-label="Files"><Fragment set:html={ui.Folder} /></button>
      <button data-app="about" title="about.txt" aria-label="about.txt"><Fragment set:html={ui.FileText} /></button>
    </nav>
  </div>

  <template id="win-tpl">
    <section class="win" role="dialog">
      <header class="win-bar">
        <span class="win-title"></span>
        <span class="win-ctrls">
          <button data-act="min" aria-label="Minimize"><Fragment set:html={ui.Minus} /></button>
          <button data-act="max" aria-label="Maximize"><Fragment set:html={ui.Square} /></button>
          <button data-act="close" aria-label="Close"><Fragment set:html={ui.X} /></button>
        </span>
      </header>
      <div class="win-body"></div>
    </section>
  </template>

  <template id="browser-tpl">
    <div class="br-bar">
      <button data-nav="back" aria-label="Back"><Fragment set:html={ui.ArrowLeft} /></button>
      <button data-nav="fwd" aria-label="Forward"><Fragment set:html={ui.ArrowRight} /></button>
      <button data-nav="reload" aria-label="Reload"><Fragment set:html={ui.RotateCw} /></button>
      <form class="br-url"><Fragment set:html={ui.Lock} /><input aria-label="Address" spellcheck="false" /></form>
      <a class="br-ext" target="_blank" rel="noopener" aria-label="Open in new tab" title="Open in new tab"><Fragment set:html={ui.ExternalLink} /></a>
    </div>
    <div class="br-page"></div>
  </template>

  <noscript>
    <article class="noscript">
      <h2>{person.name} — {person.role}</h2>
      <p>{person.summary}</p>
      <p>{experience.role} @ {experience.company} ({experience.period}) · {education.school} · CGPA {education.cgpa}</p>
      <ul>{projects.map(p => <li><strong>{p.name}</strong> — {p.description}</li>)}</ul>
      <p><a href={person.github}>GitHub</a> · <a href={person.linkedin}>LinkedIn</a> · <a href={`mailto:${person.email}`}>{person.email}</a> · <a href="/resume.pdf">Resume</a></p>
    </article>
  </noscript>
</Layout>

<script>
  import '../scripts/os';
</script>
