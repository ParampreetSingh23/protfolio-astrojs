  <!-- Interactive Venn Diagram script and Copy Email script -->
  <script>
    // Copy Email script
    const copyBtn = document.getElementById('copy-email-btn');
    const copyStatus = document.getElementById('copy-status');
    const emailText = 'parampreetsinghlall@gmail.com';

    if (copyBtn && copyStatus) {
      copyBtn.addEventListener('click', () => {
        navigator.clipboard.writeText(emailText).then(() => {
          copyStatus.classList.remove('hidden');
          setTimeout(() => {
            copyStatus.classList.add('hidden');
          }, 2000);
        });
      });
    }

    // Interactive Venn Diagram script
    const vennWeb = document.getElementById('venn-web');
    const vennDevops = document.getElementById('venn-devops');
    const vennProg = document.getElementById('venn-prog');
    const vennIntersection = document.getElementById('venn-intersection');
    
    const skillsTitle = document.getElementById('skills-title');
    const skillsDesc = document.getElementById('skills-desc');
    const skillsContainer = document.getElementById('skills-container');

    const skillsData = {
      default: {
        title: "My Tech Synthesis",
        desc: "I build at the intersection of full-stack engineering, cloud architecture, and database performance. Hover over any circle in the diagram to inspect my specific skill domains.",
        skills: [
          "HTML/CSS", "React.js", "Next.js (Learning)", "Node.js", "Express.js", "Spring Boot",
          "AWS (EC2, S3, RDS)", "Docker", "CI/CD Pipelines", "n8n Automation", "Linux / Bash",
          "Java", "Data Structures (DSA)", "C++", "SQL", "MongoDB / MySQL", "Git & GitHub", "Postman / APIs"
        ]
      },
      web: {
        title: "Web Development",
        desc: "Frontend and Backend systems designed for clean styling, responsive interactions, and scalable service layer architecture.",
        skills: [
          "HTML/CSS", "React.js", "Next.js (Learning)", "Node.js", "Express.js", "Spring Boot",
          "REST APIs", "EJS", "Auth Sessions", "Prisma / Mongoose"
        ]
      },
      devops: {
        title: "Cloud & DevOps",
        desc: "Automating server operations, containerized configurations, pipelines, and visual workflow recipes.",
        skills: [
          "AWS (EC2, S3, RDS)", "Docker", "CI/CD Pipelines", "n8n Automation", "Linux Terminal",
          "Bash Scripting", "Git & GitHub"
        ]
      },
      programming: {
        title: "Programming & Databases",
        desc: "High-performance programming languages, optimized data structures, and relational / document-store persistence.",
        skills: [
          "Java", "Data Structures (DSA)", "C++", "JavaScript", "SQL", "MongoDB", "MySQL",
          "PostgreSQL", "BST Search Optimization", "Stack/Queue History"
        ]
      },
      intersection: {
        title: "Full Stack DevOps Engineer",
        desc: "My core sweet spot. Integrating clean software architectures directly with automated deployment scripts, dockerized networks, and AWS infrastructure.",
        skills: [
          "End-to-End Systems", "Spring Boot + AWS", "React + Docker", "n8n Webhook Automations",
          "CLI DB Utilities", "Git Actions CI/CD", "Bash Build Scripts"
        ]
      }
    };

    const updatePanel = (category: string) => {
      const data = skillsData[category as keyof typeof skillsData] || skillsData.default;
      
      if (skillsTitle && skillsDesc && skillsContainer) {
        skillsTitle.textContent = data.title;
        skillsDesc.textContent = data.desc;
        
        // Render pills
        skillsContainer.innerHTML = '';
        data.skills.forEach(skill => {
          const pill = document.createElement('span');
          pill.className = `px-3 py-1.5 rounded-[6px] font-mono text-[13px] tracking-tight transition-all duration-300 ${
            category === 'intersection' 
              ? 'bg-accent-blue text-white border border-accent-blue animate-pulse' 
              : 'bg-surface-1 text-white border border-hairline'
          }`;
          pill.textContent = skill;
          skillsContainer.appendChild(pill);
        });
      }
    };

    // Attach hover events to Venn groups
    const circles = [
      { element: vennWeb, category: 'web' },
      { element: vennDevops, category: 'devops' },
      { element: vennProg, category: 'programming' },
      { element: vennIntersection, category: 'intersection' }
    ];

    circles.forEach(item => {
      if (item.element) {
        item.element.addEventListener('mouseenter', () => updatePanel(item.category));
        item.element.addEventListener('mouseleave', () => updatePanel('default'));
      }
    });

    // Handle Contact Form Submission
    const contactForm = document.getElementById('contact-form') as HTMLFormElement;
    if (contactForm) {
      contactForm.addEventListener('submit', (e) => {
        e.preventDefault();
        alert('Thank you for reaching out, Parampreet will get back to you shortly!');
        contactForm.reset();
      });
    }
  </script>
