---
import Layout from '../layouts/Layout.astro';
import '../styles/base.css';
import '../styles/os.css';
import { listDir } from '../scripts/terminal';
import { iconFor, ui } from '../scripts/icons';
import { person, projects, experience, education, skillGroups } from '../data/portfolio';
const schema = [
  { '@type': 'ProfilePage', '@id': `${person.site}/#profile`, url: `${person.site}/`, name: `${person.name} — Portfolio`, isPartOf: { '@id': `${person.site}/#website` }, mainEntity: { '@id': `${person.site}/#person` } },
  { '@type': 'ItemList', name: `Projects by ${person.name}`, itemListElement: projects.map((p, i) => ({ '@type': 'ListItem', position: i + 1, url: `${person.site}/projects/${p.slug}/`, name: p.name })) },
];
const desktop = listDir('~/Desktop');
---
<Layout schema={schema}>
  <div id="boot" class="boot" aria-hidden="true">
    <pre id="boot-log"></pre>
    <p class="boot-skip">press any key to skip</p>
  </div>

  <div id="os" class="os" data-theme="aubergine">
    <header class="topbar">
      <span class="topbar-left">Activities <b>parampreet@portfolio</b></span>
      <time id="clock" class="topbar-clock"></time>
      <span class="topbar-tray"><span aria-hidden="true"><Fragment set:html={ui.Wifi} /></span><button id="sound-toggle" aria-label="Sound off" title="Sound off" aria-pressed="false"><Fragment set:html={ui.VolumeX} /></button><span aria-hidden="true"><Fragment set:html={ui.BatteryFull} /></span><button id="restart" aria-label="Restart" title="Restart"><Fragment set:html={ui.Power} /></button></span>
    </header>

    <main class="desktop" id="desktop">
      <h1 class="sr-only">{person.name} — {person.role} portfolio</h1>
      <div class="wallmark" aria-hidden="true">parampreet<span>@</span>portfolio<small>open a file · right-click for more · or run ./github.sh</small></div>
      <ul class="icons" aria-label="Desktop files">
        {desktop.map(name => (
          <li><button class="file-icon" data-path={`~/Desktop/${name}`}><span set:html={iconFor(name)} /><span class="file-name">{name}</span></button></li>
        ))}
      </ul>
      <div id="windows"></div>
    </main>

    <nav class="dock" id="dock" aria-label="Dock">
      <button data-app="terminal" title="Terminal" aria-label="Terminal"><Fragment set:html={ui.SquareTerminal} /></button>
      <button data-app="browser" title="Browser" aria-label="Browser"><Fragment set:html={ui.Globe} /></button>
      <button data-app="files" title="Files" aria-label="Files"><Fragment set:html={ui.Folder} /></button>
      <button data-app="project" title="Projects" aria-label="Projects"><Fragment set:html={ui.Layers} /></button>
      <button data-app="about" title="about.txt" aria-label="about.txt"><Fragment set:html={ui.FileText} /></button>
    </nav>
  </div>

  <template id="win-tpl">
    <section class="win" role="dialog">
      <header class="win-bar">
        <span class="win-title"></span>
        <span class="win-ctrls">
          <button data-act="min" aria-label="Minimize"><Fragment set:html={ui.Minus} /></button>
          <button data-act="max" aria-label="Maximize"><Fragment set:html={ui.Square} /></button>
          <button data-act="close" aria-label="Close"><Fragment set:html={ui.X} /></button>
        </span>
      </header>
      <div class="win-body"></div>
    </section>
  </template>

  <template id="browser-tpl">
    <div class="br-bar">
      <button data-nav="back" aria-label="Back"><Fragment set:html={ui.ArrowLeft} /></button>
      <button data-nav="fwd" aria-label="Forward"><Fragment set:html={ui.ArrowRight} /></button>
      <button data-nav="reload" aria-label="Reload"><Fragment set:html={ui.RotateCw} /></button>
      <form class="br-url"><Fragment set:html={ui.Lock} /><input aria-label="Address" spellcheck="false" /></form>
      <a class="br-ext" target="_blank" rel="noopener" aria-label="Open in new tab" title="Open in new tab"><Fragment set:html={ui.ExternalLink} /></a>
    </div>
    <div class="br-page"></div>
  </template>

  <!-- Plain-HTML copy of everything the desktop shows: for screen readers, crawlers and AI answer engines that don't run JS. Visible when JS is off. -->
  <article id="readme" class="readme sr-only" aria-label="Portfolio summary">
    <h2>About {person.name}</h2>
    <p>{person.summary}</p>
    <p>Currently {experience.role} at {experience.company} ({experience.period}). {education.degree}, {education.school} — CGPA {education.cgpa}, {education.year.toLowerCase()}. Based in {person.location}.</p>
    <h2>Projects</h2>
    <ul>{projects.map(p => <li><a href={`/projects/${p.slug}/`}><strong>{p.name}</strong></a> — {p.description} <em>Stack: {p.stack.join(', ')}.</em></li>)}</ul>
    <h2>Skills</h2>
    <ul>{skillGroups.map(g => <li><strong>{g.name}:</strong> {g.items}</li>)}</ul>
    <h2>Contact</h2>
    <p><a href={`mailto:${person.email}`}>{person.email}</a> · <a href={person.github} rel="me">GitHub</a> · <a href={person.linkedin} rel="me">LinkedIn</a> · <a href="/resume.pdf">Resume (PDF)</a></p>
  </article>
  <noscript><style>.readme { position: fixed; inset: 32px 0 0; width: auto; height: auto; clip-path: none; white-space: normal; overflow: auto; padding: 32px; background: #0b0b0a; z-index: 900; } .readme a { color: #ff6b35; }</style></noscript>
</Layout>

<script>
  import '../scripts/os';
</script>
