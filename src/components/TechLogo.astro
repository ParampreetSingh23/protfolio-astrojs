---
import { logos } from '../data/logos';
interface Props { name: string; }
const { name } = Astro.props;
const file = logos[name];
const plate = ['aws','nextjs-icon','prisma','express','github-icon'].includes(file);
---
{file && <img class:list={['tech-logo',{ 'logo-plate': plate }]} src={`/logos/${file}.svg`} alt="" width="18" height="18" loading="lazy" decoding="async" />}
