---
import { assets } from '../data/portfolio';
import Photo from './Photo.astro';
const milestones = [
  { year: '2023', title: 'Started B.Tech.', text: 'Computer Science at Chitkara University, Rajpura, Punjab.', artifact: 'FIRST ENTRY / A QUESTION WORTH FOLLOWING' },
  { year: '2024', title: 'A page still to fill.', text: 'Learning happened here. The specific milestone and artifact are waiting to be added.', artifact: 'PLACEHOLDER / 2024 MILESTONE' },
  { year: '2025', title: 'Another chapter, pending.', text: 'Room for the projects, decisions, and lessons from this year.', artifact: 'PLACEHOLDER / 2025 MILESTONE' },
  { year: '2026 / CURRENT', title: 'From coursework to production.', text: 'Rabbitt AI · Cloud DevOps / SRE Intern. April 2026 — Present.', artifact: 'RABBITT AI / CLOUDWATCHER + DRIP' },
];
---
<section class="chapter" id="about">
  <div class="wrap">
    <div class="chapter-heading"><span class="eyebrow">001 / THE HUMAN</span><span class="mono">THERE IS A PERSON BEHIND ALL THIS.</span></div>
    <div class="split">
      <div class="about-copy"><h2 class="section-title">Who is behind<br/>the system?</h2><div class="body-copy"><p>I'm Parampreet. A final-year Computer Science undergraduate at <strong>Chitkara University</strong>, currently a <strong>Cloud DevOps / SRE Intern at Rabbitt AI</strong>.</p><p>My work sits between cloud infrastructure, backend engineering, and AI-powered systems. I'm interested in the part after “it works”: how it runs, what it tells us, and what happens when it doesn't.</p></div><dl class="about-meta"><div><dt>EDUCATION</dt><dd>B.Tech · Computer Science</dd></div><div><dt>ACADEMIC RECORD</dt><dd>9.44 CGPA</dd></div><div><dt>LOCATION</dt><dd>India</dd></div><div><dt>CURRENT MODE</dt><dd>Learning by building</dd></div></dl></div>
      <figure class="portrait-frame" data-photo>
        {assets.profile ? <a href={assets.profile.src} target="_blank" rel="noopener noreferrer" aria-label="Open Parampreet's portrait" data-cursor="OPEN"><Photo photo={assets.profile} portrait/></a> : <div class="photo-empty"><span class="photo-number" aria-hidden="true">[ 001 ]</span><span class="mono">PORTRAIT / TO BE ADDED</span><p>A photograph belongs here.</p><span class="mono">NOT A GENERATED VERSION OF ME.</span></div>}
        <figcaption class="portrait-labels"><span class="mono">HUMAN / 001</span><span class="mono">INDIA · STATUS / BUILDING</span></figcaption>
      </figure>
    </div>
  </div>
</section>
<section class="chapter" id="journey">
  <div class="wrap">
    <div class="chapter-heading"><span class="eyebrow">002 / JOURNEY</span><span class="mono">A FEW CHECKPOINTS. STILL RUNNING.</span></div>
    <div class="journey-layout">
      <div class="journey-summary"><h2 class="section-title">Nothing starts<br/><span class="muted">in production.</span></h2><p>A degree, a lot of questions, and the gradual move from understanding systems to working on them.</p><span class="mono muted">2023 — PRESENT / A WORK IN PROGRESS</span></div>
      <div class="timeline"><div class="timeline-progress" aria-hidden="true"></div>{milestones.map(m => <article class="milestone"><span class="mono">{m.year}</span><h3>{m.title}</h3><p>{m.text}</p><div class="timeline-artifact mono">{m.artifact}</div></article>)}</div>
    </div>
  </div>
</section>
