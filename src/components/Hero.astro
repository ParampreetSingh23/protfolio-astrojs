---
import SystemMap from './SystemMap.astro';
import Icon from './Icon.astro';
import { projects } from '../data/portfolio';
---
<div class="intro" id="intro" hidden aria-hidden="true"><span class="mono">INITIALIZING...</span><div class="intro-words"><span>PERSON</span><span>CURIOSITY</span><span>SYSTEMS</span><span>PARAMPREET SINGH</span></div><div class="intro-line"></div></div>
<section class="hero wrap" id="home">
  <div class="hero-top mono"><span><i class="status-dot orange"></i> A PERSONAL ENGINEERING NOTEBOOK</span></div>
  <div class="hero-layout">
    <div class="hero-copy">
      <h1><span class="hero-line">I like</span><span class="hero-line">breaking</span><span class="hero-line">things<span class="orange-text">.</span></span></h1>
      <p class="hero-follow">Then figuring out why they broke.<br/>Then building something<br class="desktop-break"/> that doesn't break again.</p>
      <div class="hero-actions"><a class="button magnetic" href="#about">ENTER THE SYSTEM <Icon name="ArrowDown" /></a><a class="text-link" href="#work">VIEW WORK <Icon name="ArrowUpRight" /></a></div>
    </div>
    <div class="hero-art"><SystemMap /><span class="hand-note">everything is connected.</span></div>
  </div>
  <div class="hero-bottom"><div><strong>PARAMPREET SINGH</strong><span class="mono">COMPUTER SCIENCE · CLOUD DEVOPS · SRE · AI</span></div><span class="discipline mono">AI <b>×</b> CLOUD <b>×</b> SYSTEMS</span><a href="#notebook" class="scroll-note mono">SCROLL TO EXPLORE <Icon name="ArrowDown" /></a></div>
</section>
<section class="notebook-index wrap" id="notebook" aria-label="Notebook index">
  <div class="index-intro"><span class="eyebrow">FIELD NOTES / SELECTED WORK</span><h2>A notebook that<br/>accidentally became<br/><span class="muted">a portfolio.</span></h2><p>Some production systems. Some personal experiments. A few rabbit holes worth getting lost in.</p></div>
  <div class="index-list">{projects.map((p,i) => <a class="project-index" href={`#${p.slug}`} data-cursor="VIEW"><span class="mono">0{i+1}</span><div><h3>{p.name}</h3><span class="mono">{p.type}</span></div><Icon /></a>)}</div>
</section>
