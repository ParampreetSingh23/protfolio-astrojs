---
import Icon from './Icon.astro';
import TechLogo from './TechLogo.astro';
import TechnologyList from './TechnologyList.astro';
import { projects, skillGroups } from '../data/portfolio';
const paths = [
  { title: 'An API call was just the start.', label: '01 / AI SYSTEMS', nodes: [
    ['AI','What changes when a model becomes one component in a larger system?'],['LLMs','How do context, latency, and provider behavior shape the application around a model?'],['Agents','Where should reasoning stop and deterministic execution begin?'],['Tool calling','How do typed inputs and bounded permissions make a tool safe to execute?'],['MCP','What becomes possible when tools expose a shared, explicit protocol?'],['AI infrastructure','How do you observe, deploy, and control the cost of the whole system?'],
  ] },
  { title: 'It worked in a container.', label: '02 / THE RUNTIME', nodes: [
    ['Docker','What exactly is isolated, and what still belongs to the host?'],['Containers','How do processes, namespaces, and resource limits fit together?'],['Kubernetes','How does desired state become a running workload?'],['Networking','Where does a request go between two services?'],['CNI','How does a pod get connected to the network?'],['Observability','Which signals explain why a healthy-looking workload is failing?'],
  ] },
  { title: 'One server became a system.', label: '03 / CLOUD INFRASTRUCTURE', nodes: [
    ['AWS','What should be managed, and what should remain under explicit control?'],['EC2','What does a reliable deployment need beyond a running instance?'],['ECS','How do tasks and services change container operations?'],['EKS','When does Kubernetes justify its operational complexity?'],['Infrastructure as Code','How do you review an infrastructure change before applying it?'],['Terraform','How do state, plans, and reusable modules keep infrastructure understandable?'],
  ] },
];
const incidentFields = ['WHAT HAPPENED?','WHY?','HOW I DEBUGGED IT','WHAT I CHANGED','WHAT I LEARNED'];
---
<section class="chapter" id="rabbit-holes"><div class="wrap"><div class="chapter-heading"><span class="eyebrow">005 / RABBIT HOLES</span><span class="mono">CURIOSITY DOES NOT RESPECT SCOPE.</span></div><div class="rabbit-heading"><h2 class="section-title">One question.<br/><span class="muted">Six tabs later.</span></h2><p>Things I started learning for one reason and somehow ended up exploring for three weeks. Open a node. Follow the question.</p></div><div class="rabbit-paths">{paths.map(path => <article class="rabbit-path"><span class="mono">{path.label}</span><h3>{path.title}</h3>{path.nodes.map(([name,note]) => <details class="rabbit-node"><summary><span class="rabbit-topic"><TechLogo name={name}/>{name}</span></summary><p>{note}</p><span class="mono">EXPLORATION PROMPT / NOT A COMPLETED CASE STUDY</span></details>)}</article>)}</div><aside class="obsession"><div><span class="eyebrow">CURRENTLY OBSESSED WITH</span><h3>AI<br/>infrastructure.</h3><span class="mono muted">CURRENT EXPLORATION</span><div class="exploration-bar" aria-hidden="true">{Array.from({length:8},()=> <i></i>)}</div></div><div><blockquote>How do you actually run AI systems reliably?<br/>Not just call an API. Run them. Observe them. Scale them. Debug them. Control their cost.</blockquote><div class="obsession-topics"><span>Kubernetes</span><span>LLM gateways</span><span>AI agents</span><span>Observability</span><span>Inference</span><span>Cloud infrastructure</span></div></div></aside></div></section>
<section class="chapter" id="lab"><div class="wrap"><div class="chapter-heading"><span class="eyebrow">006 / ENGINEERING LAB</span><span class="mono">WORKING DIRECTORY / ALWAYS OPEN</span></div><div class="lab-columns"><div><h2 class="section-title">Still building.<br/><span class="muted">Still figuring it out.</span></h2><p class="body-copy">A working directory, not a trophy cabinet. Confirmed projects live here. Smaller experiments will get their own entries when there is something real to show.</p></div><div><div class="filesystem"><div class="diagram-bar mono"><span><Icon name="Terminal"/> ~/parampreet/lab</span><span>INDEX</span></div>{projects.map((p,i) => <div class="file-row"><span class="mono">{i === projects.length-1 ? '└──' : '├──'}</span><a href={`/projects/${p.slug}/`} data-cursor="VIEW">{p.slug}/ <Icon /></a></div>)}<div class="file-row"><span class="mono">+</span><span class="placeholder-note">experiment notes / awaiting real entries</span></div></div><p class="lab-note">No invented experiments. Just room for the next one.</p></div></div>
<div class="broken"><div class="broken-header"><div><span class="eyebrow">~/parampreet/failures</span><h3>Things I've<br/>broken<span class="orange-text">.</span></h3></div><p>Failures deserve field notes too. These are empty templates, waiting for actual incidents and what I learned from them.</p></div>{['Incident notes','Debugging notes','Lessons learned'].map((title,i) => <details class="incident"><summary><span class="mono">0{i+1}</span><span>{title}</span><span class="placeholder-note">UNFILLED TEMPLATE</span><Icon name="Plus"/></summary><div class="incident-body">{incidentFields.map(field => <div><h4>{field}</h4><p>Pending a real incident.</p></div>)}</div></details>)}</div>
<div class="skills-map" id="skills"><div class="skills-layout"><div><span class="eyebrow">TOOLS / NOT AN IDENTITY</span><h3>The stack changes.<br/>Fundamentals stay.</h3><div class="fundamentals"><strong>350<span class="orange-text">+</span></strong><p>Data structures & algorithms problems solved.</p><div class="mono">DATA STRUCTURES / ALGORITHMS<br/>OPERATING SYSTEMS / DATABASES / NETWORKS<br/>OOP / SOFTWARE DESIGN PRINCIPLES</div></div><p class="certifications">IBM — Introduction to Agile Development and Scrum<br/>IBM — Introduction to DevOps</p></div><div>{skillGroups.map((g,i) => <details class="skill-group" open={i===3}><summary><div><span>0{i+1}</span>{g.name}</div></summary><div class="skill-technologies"><TechnologyList items={g.items.split(' / ')}/></div></details>)}</div></div></div>
</div></section>
