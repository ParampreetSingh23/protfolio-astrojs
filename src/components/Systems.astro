---
import Icon from './Icon.astro';
import TechnologyList from './TechnologyList.astro';
import { projects, assets } from '../data/portfolio';
const tisi = projects[2];
const campus = projects[3];
const stages = ['PLAN','VALIDATE','APPROVE','EXECUTE','VERIFY'];
const staging = ['GITHUB REPOSITORY','ANALYSE','DETECT','runtime / services / dependencies','STAGING PLAN','AWS EC2','DOCKER','DEPLOY','VERIFY'];
---
<section class="chapter" id="systems">
  <div class="wrap" id="tisiops">
    <div class="chapter-heading"><span class="eyebrow">004 / SYSTEMS</span><span class="mono">PERSONAL PROJECT / FOUNDER & DEVELOPER</span></div>
    <div class="systems-heading"><h2>TisiOps<span class="orange-text">.</span></h2><p class="body-copy">AI-powered DevOps.<br/>A plan is useful. A controlled,<br/>verified execution is better.</p></div>
    <div class="systems-context mono"><span>CLOUD PROVISIONING / DEPLOYMENT / STAGING</span><span>MONITORING / LOGGING / DIAGNOSIS</span></div>
    <div class="guardrail"><strong>The agent proposes. The system controls execution.</strong><p>Infrastructure actions follow validation and approval, then run as controlled jobs through Redis, BullMQ, and a worker. The LLM does not get uncontrolled direct shell access.</p></div>
    <div class="diagram" data-architecture><div class="diagram-bar mono"><span>USER → AI AGENT / CONTROLLED EXECUTION</span><span>FIG. 04A</span></div><ol class="workflow" aria-label="Infrastructure execution lifecycle">{stages.map((s,i) => <li class="workflow-step" data-job-step={i}><span>0{i+1}</span>{s}</li>)}</ol><div class="diagram-foot mono">PLAN FIRST. VERIFY LAST. / ARCHITECTURE DEMONSTRATION</div></div>
    <div class="tisi-console">
      <div><div class="diagram-bar mono"><span><Icon name="Terminal" /> JOB EXECUTION / DEMO</span><span>CONTROLLED WORKER</span></div><div class="job-area"><div class="job-heading"><span class="mono">JOB #1842</span><span class="job-state" id="job-state" role="status">QUEUED</span></div><div class="queue-path mono"><span>AI</span><Icon name="ArrowRight"/><span>CONTROLLED JOB</span><Icon name="ArrowRight"/><span>REDIS / BULLMQ</span><Icon name="ArrowRight"/><span>WORKER</span><Icon name="ArrowRight"/><span>INFRASTRUCTURE</span></div><div class="job-logs" id="job-logs"><span>[12:42:08] job created</span><span>[12:42:09] waiting for validation + approval</span></div><div class="console-controls"><button class="button secondary" id="replay-job">RUN DEMO <Icon name="ArrowRight"/></button><span class="demo-label mono">ILLUSTRATIVE LOGS / NO REAL DEPLOYMENT</span></div></div></div>
      <div class="observability"><span class="eyebrow">OBSERVABILITY / VISUAL DEMO</span><h3>What is the system telling us?</h3>{[{name:'CPU',value:42},{name:'MEMORY',value:61},{name:'DISK',value:37}].map(m => <div class="metric"><span>{m.name}</span><div class="metric-bar"><span style={`width:${m.value}%`}></span></div><span>{m.value}%</span></div>)}<div class="metric"><span>UPTIME</span><span><i class="status-dot"></i> ONLINE</span><span>DEMO</span></div><div class="telemetry-path mono">SERVER / CPU / RAM / DISK / DOCKER / APPLICATION<br/><strong>OpenTelemetry → SigNoz</strong></div><p class="placeholder-note">Static example values. Not connected to a live server.</p></div>
    </div>
    <div class="diagram staging-panel"><div class="diagram-bar mono"><span>PRODUCTION → STAGING / VISUAL DEMO</span><span>FIG. 04B</span></div><div class="staging-layout"><div class="staging-copy"><h3>From a repository<br/>to a staging plan.</h3><p>Analyse the runtime, services, and dependencies. Build the plan, then deploy and verify it.</p><button class="button secondary" id="scan-repo">SCAN DEMO <Icon name="ArrowRight"/></button><p class="placeholder-note" id="scan-status" role="status">Illustrative flow. No repository is accessed.</p></div><div class="staging-flow" aria-label="Staging deployment sequence">{staging.map((s,i) => <span class:list={[{detect:i===3}]} data-scan-step>{s}</span>)}</div></div></div>
    <div class="stack-line"><TechnologyList items={tisi.stack}/></div><a class="text-link" href="/projects/tisiops/" data-cursor="VIEW">READ THE SYSTEM NOTES <Icon /></a>
    {assets.screenshots.tisiops && <figure><img src={assets.screenshots.tisiops.src} alt={assets.screenshots.tisiops.alt} width={assets.screenshots.tisiops.width} height={assets.screenshots.tisiops.height} loading="lazy" decoding="async"/><figcaption class="placeholder-note">{assets.screenshots.tisiops.caption}</figcaption></figure>}
    <article class="case-panel campus-panel" id="campusbarter"><div class="case-copy"><span class="mono">03 / A SMALLER SYSTEM, A DIFFERENT PROBLEM</span><h3>CampusBarter</h3><p class="case-subtitle">Peer-to-peer campus marketplace</p><p>A campus marketplace with Google OAuth and local authentication, real-time chat over WebSockets, and serverless PostgreSQL through Drizzle ORM.</p><p>React Query handles server state; Zod validates input. Tailwind provides the interface styling, with Render for deployment.</p><div class="stack-line"><TechnologyList items={campus.stack}/></div><a class="text-link" href="/projects/campusbarter/" data-cursor="VIEW">OPEN FIELD NOTES <Icon /></a></div><div class="diagram" data-architecture><div class="diagram-bar mono"><span>MARKETPLACE / ARCHITECTURE</span><span>FIG. 04C</span></div><div class="campus-architecture"><div class="campus-node" data-node>REACT<span>QUERY / TAILWIND</span></div><div class="campus-node" data-node>EXPRESS / NODE.JS<span>AUTH / ZOD</span></div><div class="campus-node" data-node>WEBSOCKETS<span>REAL-TIME CHAT</span></div><div class="campus-node" data-node>OAUTH / LOCAL<span>AUTHENTICATION</span></div><div class="campus-node" data-node>POSTGRESQL / DRIZZLE<span>SERVERLESS PERSISTENCE</span></div></div><div class="diagram-foot mono">ARCHITECTURAL ILLUSTRATION / NOT A PRODUCT SCREENSHOT</div></div></article>
    {assets.screenshots.campusbarter && <figure><img src={assets.screenshots.campusbarter.src} alt={assets.screenshots.campusbarter.alt} width={assets.screenshots.campusbarter.width} height={assets.screenshots.campusbarter.height} loading="lazy" decoding="async"/><figcaption class="placeholder-note">{assets.screenshots.campusbarter.caption}</figcaption></figure>}
  </div>
</section>
