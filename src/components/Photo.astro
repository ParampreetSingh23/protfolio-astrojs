---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { Photo } from '../data/portfolio';
interface Props { photo: Photo; portrait?: boolean; }
const { photo, portrait = false } = Astro.props;
const local = import.meta.glob<{default: ImageMetadata}>('/public/images/**/*.{png,jpg,jpeg,webp}', { eager: true });
const image = local[`/public${photo.src}`]?.default;
const sizes = portrait ? '(max-width: 540px) calc(100vw - 84px), (max-width: 800px) 40vw, 580px' : '(max-width: 540px) calc(100vw - 74px), (max-width: 800px) 42vw, 400px';
---
{image ? <Image src={image} alt={photo.alt} widths={[240,480,720]} sizes={sizes} format={portrait ? 'png' : 'webp'} width={portrait ? 720 : 480} loading="lazy" decoding="async" /> : <img src={photo.src} alt={photo.alt} width={photo.width} height={photo.height} loading="lazy" decoding="async"/>}
