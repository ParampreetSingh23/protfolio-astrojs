---
import Icon from './Icon.astro';
import TechnologyList from './TechnologyList.astro';
import { projects, assets } from '../data/portfolio';
const cloud = projects[0];
const drip = projects[1];
const cloudNodes = [
  {x:40,y:60,w:120,name:'AWS / EC2',sub:'INFRASTRUCTURE',logo:'aws-ec2'},
  {x:230,y:60,w:190,name:'CLOUDWATCH',sub:'METRIC COLLECTION',logo:'aws-cloudwatch'},
  {x:230,y:170,w:190,name:'THRESHOLD',sub:'EVALUATE METRICS'},
  {x:230,y:280,w:190,name:'ALARM',sub:'ATTENTION REQUIRED',alert:true},
  {x:40,y:280,w:120,name:'SNS',sub:'NOTIFICATION',alert:true,logo:'aws-sns'},
];
const dripNodes = ['USER','NEXT.JS / REACT','API / BACKEND','AI / LLM PROVIDERS','POSTGRESQL'];
---
<section class="chapter" id="work">
  <div class="wrap">
    <div class="chapter-heading"><span class="eyebrow">003 / EXPERIENCE</span><span class="mono">WHERE THE SYSTEMS ARE REAL.</span></div>
    <div class="experience-title"><h2 class="section-title">Production<span class="orange-text">.</span></h2><div class="role-line"><strong>Rabbitt AI</strong><span class="mono">CLOUD DEVOPS / SRE INTERN<br/>APRIL 2026 — PRESENT</span></div></div>
    <p class="experience-intro">Working across production systems, cloud infrastructure, observability, backend services, and AI-powered developer tooling. Two systems from that work:</p>
    <article class="case-panel" id="cloudwatcher">
      <div class="case-copy"><span class="mono">01 / INFRASTRUCTURE THAT TELLS YOU SOMETHING</span><h3>CloudWatcher</h3><p class="case-subtitle">Cloud observability tool</p><p>Reusable infrastructure-as-code for AWS monitoring. Terraform modules define CloudWatch alarms, SNS topics, and IAM roles; Node.js and Python collect metrics and support threshold-based alerts.</p><ul><li>Provision monitoring with reusable Terraform modules</li><li>Collect metrics and automate threshold alerts</li><li>Collaborate through branching, reviews, and issues</li></ul><div class="stack-line"><TechnologyList items={cloud.stack}/></div><a class="text-link" href="/projects/cloudwatcher/" data-cursor="VIEW">OPEN FIELD NOTES <Icon /></a></div>
      <div class="diagram" data-architecture>
        <div class="diagram-bar mono"><span><Icon name="Layers" /> MONITORING / SIGNAL PATH</span><span>FIG. 03A</span></div>
        <svg viewBox="0 0 460 410" role="img" aria-label="EC2 metrics go to CloudWatch, thresholds activate alarms, SNS sends an alert.">
          <path class="diagram-boundary" d="M20 35H440V365H20Z"/><text class="diagram-label" x="30" y="27">AWS / TERRAFORM MANAGED</text>
          <path class="diagram-line" data-draw d="M160 89H230M325 118V170M325 228V280"/><path class="diagram-line alert" data-draw d="M230 309H160M100 338V385H230"/>
          <path class="signal-flow" d="M160 89H230M325 118V170M325 228V280"/><path class="signal-flow alert" d="M230 309H160M100 338V385H230"/>
          {cloudNodes.map(n => <g class:list={['diagram-node',{alert:n.alert}]} data-node><rect x={n.x} y={n.y} width={n.w} height="58" rx="2"/>{n.logo ? <image href={`/logos/${n.logo}.svg`} x={n.x+9} y={n.y+15} width="14" height="14"/> : <circle cx={n.x+13} cy={n.y+22} r="3"/>}<text x={n.x+29} y={n.y+26}>{n.name}</text><text class="sub" x={n.x+13} y={n.y+45}>{n.sub}</text></g>)}
          <text x="353" y="150" class="diagram-label">METRICS</text><text x="350" y="258" class="diagram-label">BREACH</text><text x="240" y="389" class="diagram-label">ALERT DELIVERED</text>
        </svg>
        <div class="diagram-foot mono"><i class="status-dot"></i> CONCEPTUAL ARCHITECTURE <span class="diagram-demo">/ NOT LIVE TELEMETRY</span></div>
      </div>
    </article>
    <article class="case-panel" id="drip">
      <div class="case-copy"><span class="mono">02 / AI, WITH DEVELOPER CONTEXT</span><h3>DRIP</h3><p class="case-subtitle">AI-powered developer productivity platform</p><p>Developer assistance for generating code, debugging, and refactoring across multiple LLM providers. A Next.js frontend connects authentication, modular APIs, contextual assistance, and PostgreSQL persistence.</p><ul><li>Scalable frontend, server-side rendering, and state management</li><li>Authentication and modular backend APIs</li><li>GitHub Actions, Docker, and AWS deployment</li></ul><div class="stack-line"><TechnologyList items={drip.stack}/></div><a class="text-link" href="/projects/drip/" data-cursor="VIEW">OPEN FIELD NOTES <Icon /></a></div>
      <div class="diagram" data-architecture>
        <div class="diagram-bar mono"><span><Icon name="GitBranch" /> APPLICATION / CONTEXT PATH</span><span>FIG. 03B</span></div>
        <svg viewBox="0 0 460 460" role="img" aria-label="User to Next.js, API and backend, LLM providers, and PostgreSQL, with Docker and AWS infrastructure.">
          <rect class="diagram-boundary" x="35" y="90" width="390" height="350"/><text class="diagram-label" x="48" y="80">DOCKER / AWS INFRASTRUCTURE</text>
          <path class="diagram-line" data-draw d="M230 75V405"/>
          {dripNodes.map((name,i) => <g class="diagram-node" data-node><rect x="110" y={25+i*80} width="240" height="50" rx="2"/><circle cx="127" cy={50+i*80} r="3"/><text x="149" y={54+i*80}>{name}</text></g>)}
          <text class="diagram-label" x="365" y="137">SSR</text><text class="diagram-label" x="365" y="217">AUTH</text><text class="diagram-label" x="365" y="297">CONTEXT</text><text class="diagram-label" x="365" y="377">STATE</text>
        </svg>
        <div class="diagram-foot mono">CONCEPTUAL ARCHITECTURE / MULTIPLE LLM PROVIDERS</div>
      </div>
    </article>
    {['cloudwatcher','drip'].map(slug => assets.screenshots[slug] && <figure><img src={assets.screenshots[slug]!.src} alt={assets.screenshots[slug]!.alt} width={assets.screenshots[slug]!.width} height={assets.screenshots[slug]!.height} loading="lazy" decoding="async"/><figcaption class="placeholder-note">{assets.screenshots[slug]!.caption}</figcaption></figure>)}
  </div>
</section>
