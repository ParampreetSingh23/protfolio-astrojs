---
import { assets, person } from '../data/portfolio';
import Icon from './Icon.astro';
import Photo from './Photo.astro';
import SystemMap from './SystemMap.astro';
---
<section class="chapter" id="outside"><div class="wrap"><div class="chapter-heading"><span class="eyebrow">007 / OUTSIDE THE TERMINAL</span><span class="mono">NOT EVERYTHING NEEDS A README.</span></div><div class="outside-intro"><h2 class="section-title">Life happens<br/><span class="muted">off-screen, too.</span></h2><p>A place for the photographs, people, and small moments that don't fit in a commit message.</p></div><div class="scrapbook">{assets.personal.length ? assets.personal.map(photo => <figure class="scrap-photo" data-photo><a href={photo.src} target="_blank" rel="noopener noreferrer" aria-label={`Open photograph: ${photo.alt}`} data-cursor="OPEN"><Photo photo={photo}/></a><figcaption>{photo.caption}</figcaption></figure>) : ['A moment worth keeping.','Somewhere beyond the screen.','The rest of the story.'].map((caption,i) => <figure class="scrap-photo"><div class="scrap-empty"><b aria-hidden="true">+ 0{i+1}</b><span>PERSONAL PHOTO / TO BE ADDED</span></div><figcaption>{caption}<br/>PLACEHOLDER / NO PHOTO SUPPLIED</figcaption></figure>)}</div>
<div class="terminal-section"><div class="terminal-intro"><span class="eyebrow">FOR THE TERMINALLY CURIOUS</span><h3>Prefer a<br/>command line?</h3><p>Same notebook. A different way in. Type <code>help</code> to find your bearings.</p></div><div class="terminal-shell"><div class="terminal-bar"><span class="dots" aria-hidden="true"><i></i><i></i><i></i></span><span>parampreet@portfolio:~</span><Icon name="Terminal"/></div><div class="terminal-output" id="terminal-output" role="log" aria-live="polite" aria-label="Terminal output" data-lenis-prevent><div class="terminal-entry">Welcome to the system.<br/>Type help. No sudo required.</div></div><form class="terminal-form" id="terminal-form"><label for="terminal-input">parampreet@portfolio:~$</label><input id="terminal-input" name="command" autocomplete="off" autocapitalize="off" spellcheck="false" maxlength="120" aria-describedby="terminal-hint" placeholder="help"/><button type="submit" aria-label="Enter: run terminal command">ENTER</button></form><div class="terminal-hint" id="terminal-hint">help · about · projects · experience · skills · lab · contact · clear<br/>↑ / ↓ command history</div><noscript><p class="placeholder-note">Enable JavaScript for the terminal. Every section is available through navigation.</p></noscript></div></div>
</div></section>
<section class="chapter contact" id="contact"><div class="wrap"><div class="chapter-heading"><span class="eyebrow">008 / CONTACT</span><span class="mono">GOOD SYSTEMS START WITH A CONVERSATION.</span></div><h2>Build something<br/>interesting<span class="orange-text">?</span></h2><div class="contact-bottom"><p>Let's talk.</p><div class="contact-links"><a href={`mailto:${person.email}`} data-cursor="GO">EMAIL <Icon/></a><a href={person.github} target="_blank" rel="noopener noreferrer" data-cursor="CODE">GITHUB <Icon/></a><a href={person.linkedin} target="_blank" rel="noopener noreferrer" data-cursor="GO">LINKEDIN <Icon/></a></div></div></div></section>
<section class="loop wrap" id="loop"><div><span class="eyebrow">END OF NOTEBOOK / BACK TO THE SYSTEM</span><h2>You've reached the end.<br/><span class="muted">Or maybe...<br/>just another starting point.</span></h2><a class="button secondary" href="#home">RUN IT AGAIN <Icon name="ArrowUpRight"/></a></div><div class="loop-map"><SystemMap closing/></div></section>
