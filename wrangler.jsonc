{
	"compatibility_date": "2026-06-10",
	"compatibility_flags": ["global_fetch_strictly_public"],
	"name": "protfolio-astrojs",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"kv_namespaces": [
		{
			"binding": "SESSION",
			"id": "7a609b5ab2fc4f6a968ae01787104daf"
		}
	],
	// portfolio.* is canonical. The apex stays attached only so Cloudflare keeps its DNS record + certificate;
	// a Redirect Rule (see DOMAIN-MIGRATION.md) 301s it to portfolio.* before the Worker runs.
	"routes": [
		{ "pattern": "portfolio.parampreetsingh.dev", "custom_domain": true },
		{ "pattern": "parampreetsingh.dev", "custom_domain": true }
	],
	"observability": {
		"enabled": true
	}
}